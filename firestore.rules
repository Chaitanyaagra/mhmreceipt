rules_version = '2';

// ============================================================================
// MHMRWS Portal — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules tab)
//
// SECURITY MODEL
//   * Residents can only ever read/write their OWN member + payment records.
//   * Committee roles are enforced HERE, not just in the UI — hiding a button
//     in admin.html is not security; someone with a console can still fire the
//     write. Every privileged action re-checks the caller's role server-side.
//   * Financial data is validated server-side too. The client validates for a
//     good user experience; these rules are what actually protect the ledger.
//   * Nothing in members/payments is ever hard-deleted — the app soft-deletes
//     by flipping a status field, preserving the legal audit trail.
//   * Once a payment is VERIFIED it is frozen. Corrections are made with a
//     reversing entry, never by editing history — that is what an auditor
//     expects to see.
//   * The public (unauthenticated) collections are keyed by an unguessable
//     random token, NOT by the sequential receipt/member number, so nobody can
//     walk 000001..999999 and scrape the resident directory or the ledger.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- identity helpers ---------- */
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Firestore caches get()/exists() per document per request, so the pair of
    // lookups below costs at most two document reads for a whole evaluation,
    // however many helpers call them.
    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      // Existence of an admins/{uid} doc is NOT sufficient on its own. A
      // record carrying a stale role (e.g. a post the society has since
      // abolished), a typo'd role, or no role field at all would otherwise
      // still pass this check — and bare isAdmin() is what gates reading
      // every resident's record (Aadhaar/PAN included), every payment, and
      // every poll vote. So the role has to be one the society currently
      // recognises, matching exactly the list the admins/{uid} write rule
      // below enforces on creation.
      return isSignedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             && adminRole() in ['superadmin', 'president', 'secretary', 'jointsecretary', 'treasurer'];
    }
    function isSuperAdmin() {
      return isAdmin() && adminRole() == 'superadmin';
    }
    // Only the Treasurer (and Super Admin) may touch money.
    function canVerifyPayments() {
      return isAdmin() && adminRole() in ['superadmin', 'treasurer'];
    }
    // Office-bearers who may approve/reject residents.
    function canApproveMembers() {
      return isAdmin() && adminRole() in ['superadmin', 'president', 'secretary', 'jointsecretary'];
    }
    // Any signed-in resident whose OWN member doc is currently approved —
    // used to gate voting eligibility, same exists()+get() shape as isAdmin().
    function isApprovedMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }
    // A gate-security guard account — created by an office-bearer from the
    // admin panel's Gate Security tab, never self-registered. A guard is
    // NOT an admin: this is checked everywhere it matters instead of ever
    // folding into isAdmin(), so a guard account can never read
    // members/payments/expenses or anything financial. Same
    // exists()+active-flag shape as isAdmin(), so a deactivated guard
    // (shift ended, device lost) loses access the instant the record is
    // flipped, without deleting their login and losing the attribution
    // trail on entries they already logged.
    function isGuard() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/guards/$(request.auth.uid))
        && get(/databases/$(database)/documents/guards/$(request.auth.uid)).data.active == true;
    }
    // Paid facility staff — Manager (day-to-day facility operations) or
    // Supervisor (conducts inspections, first point of contact on
    // complaints) — a third identity alongside resident and committee-admin.
    // Same "created by an office-bearer, active flag as the kill-switch"
    // shape as isGuard(), and just as deliberately NOT folded into
    // isAdmin(): staff can inspect and work complaints, never touch
    // members/payments/expenses/committee settings.
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.active == true;
    }
    // A Managing Staff triages the whole queue; a Supervisor is a field
    // worker who should only ever see complaints assigned to them. This
    // distinction is enforced in the complaints read rule, not just the UI.
    function isManagerStaff() {
      return isStaff() && staffDoc().data.role == 'manager';
    }
    /* ---------- validation helpers ---------- */
    //
    // ABSENCE vs NULL — read this before editing anything below.
    //
    // Reading a field that is not present on the document raises an evaluation
    // error, and an erroring rule DENIES. So `data.foo == null` is not a safe
    // "foo is empty" test: it works when the client writes an explicit null and
    // breaks with an opaque permission error when the client simply omits the
    // field. Every optional field is therefore checked through absentOrNull().
    //
    function absentOrNull(data, field) {
      return !(field in data) || data[field] == null;
    }
    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }
    function isOptionalString(data, field, maxLen) {
      return absentOrNull(data, field) || (data[field] is string && data[field].size() <= maxLen);
    }
    // Same "absent/blank is fine, but if present it must be real" shape as
    // isOptionalString — blank is what bulk-import already saves when a
    // spreadsheet row has no mobile column filled in, so this must keep
    // accepting that rather than retroactively locking those members out
    // of ever being edited again. What it closes is a raw write saving
    // garbage like "123" as somebody's mobile number.
    function isOptionalMobile(data, field) {
      return absentOrNull(data, field)
          || (data[field] is string && (data[field] == '' || data[field].matches('^[0-9]{10}$')));
    }
    function isOptionalDateString(data, field) {
      return absentOrNull(data, field)
          || (data[field] is string && data[field].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function isOptionalFamilyList(data, field) {
      // Light-touch on purpose: this is descriptive data (used only to show a
      // birthday/anniversary reminder), not anything security-sensitive, so it
      // isn't worth a deep per-item shape check the way payments/expenses are.
      return absentOrNull(data, field)
          || (data[field] is list && data[field].size() <= 20);
    }
    // A 10-digit Indian mobile number.
    function isValidMobile(v) {
      return v is string && v.matches('^[0-9]{10}$');
    }
    // Guards against negative amounts, zero, absurd typos and non-numeric junk.
    function isValidAmount(v) {
      return v is number && v > 0 && v <= 1000000;
    }
    function isValidPaymentMode(v) {
      return v in ['cash', 'cheque', 'upi', 'netbanking'];
    }
    function isValidMemberStatus(v) {
      return v in ['pending', 'approved', 'rejected', 'inactive'];
    }
    function isValidComplaintStatus(v) {
      return v in ['open', 'in_progress', 'resolved', 'closed', 'rejected'];
    }
    function isValidPaymentStatus(v) {
      return v in ['pending_approval', 'pending_verification', 'verified', 'rejected', 'voided'];
    }
    // "2025-26" style financial year.
    // Build today's date as YYYY-MM-DD from request.time for "not in the
    // past" checks. UTC-based; the IST/UTC edge only matters in the ~5.5h
    // before UTC midnight, where being a day lenient is harmless for a
    // past-date guard (it never wrongly rejects a valid same-day booking).
    function todayISO() {
      return string(request.time.year()) + '-'
        + (request.time.month() < 10 ? '0' : '') + string(request.time.month()) + '-'
        + (request.time.day() < 10 ? '0' : '') + string(request.time.day());
    }
    function isValidFY(v) {
      // Format: YYYY-YY, then bound the start-year to a window around now so
      // a raw client can't post into 1990-91 or 2035-36. Indian FY starts in
      // April: current FY start-year is this calendar year once past March,
      // else last year. Accept [now-2 .. now+1] — covers backdated office
      // entries and just-before-new-FY payments. The 4-char year prefix is
      // read with a substring slice (supported on strings in rules) and
      // compared as an int.
      return v is string
          && v.matches('^[0-9]{4}-[0-9]{2}$')
          && fyStartYear(v) >= currentFyStart() - 2
          && fyStartYear(v) <= currentFyStart() + 1;
    }
    function fyStartYear(v) {
      return int(v[0:4]);
    }
    function currentFyStart() {
      return request.time.year() - (request.time.month() >= 4 ? 0 : 1);
    }
    // 32 hex characters from crypto.getRandomValues() — see newPublicToken()
    // in app-common.js. 128 bits of entropy is not walkable.
    function isPublicToken(v) {
      return v is string && v.matches('^[0-9a-f]{32}$');
    }
    // Absence-safe: an update that adds a field which was not there before is
    // a change, and an update that drops one is too.
    function unchanged(field) {
      return (field in request.resource.data) == (field in resource.data)
          && (!(field in resource.data) || request.resource.data[field] == resource.data[field]);
    }

    // ---- Residents ------------------------------------------------------
    match /members/{uid} {
      function validMemberShape() {
        return isNonEmptyString(request.resource.data.name, 100)
            && isNonEmptyString(request.resource.data.tower, 50)
            && isNonEmptyString(request.resource.data.flatNumber, 30)
            && isOptionalMobile(request.resource.data, 'mobile')
            && isOptionalString(request.resource.data, 'fatherHusbandName', 100)
            && isOptionalString(request.resource.data, 'address', 500)
            && isOptionalString(request.resource.data, 'occupation', 100)
            && isOptionalString(request.resource.data, 'nomineeName', 100)
            // Birthday/anniversary reminder data — all optional, never required,
            // since not every resident wants to share a family member's DOB.
            && isOptionalDateString(request.resource.data, 'dob')
            && isOptionalDateString(request.resource.data, 'anniversary')
            && isOptionalFamilyList(request.resource.data, 'familyMembers')
            && isValidMemberStatus(request.resource.data.status)
            && request.resource.data.residentType in ['owner', 'jointowner', 'tenant'];
      }

      allow read: if isOwner(uid) || isAdmin();

      // A resident self-registering must land as 'pending' with no Member ID.
      // Only an admin can create a pre-approved row (bulk import / data entry).
      allow create: if (isAdmin() && validMemberShape())
                    || (
                      isOwner(uid)
                      && validMemberShape()
                      && request.resource.data.uid == uid
                      && request.resource.data.status == 'pending'
                      && absentOrNull(request.resource.data, 'memberID')
                      && absentOrNull(request.resource.data, 'publicToken')
                      && request.resource.data.role == 'resident'
                      && isValidMobile(request.resource.data.mobile)
                    );

      // Admin edits: only office-bearers may change approval status or assign
      // a Member ID. Any other admin may correct ordinary profile fields.
      //
      // Residents may edit their own profile but never self-approve, grant
      // themselves a Member ID or verification token, reactivate themselves,
      // change their role — or move themselves to a different flat. That last
      // one matters: maintenance rates are per-tower, so an unpinned flat
      // number is a way to change your own dues and what your card says.
      //
      // Known, deliberately-unfixed-here limitation: canApproveMembers()
      // below still permits tower/flatNumber to change on this document
      // alone, because the legitimate flow (admin.html's edit-member
      // transfer, and the two admin-creates-a-resident flows) MUST be able
      // to change them — and does so correctly, in the same transaction as
      // the matching flatClaims delete+create. Firestore rules evaluate
      // each document in a transaction independently and cannot see "a
      // flatClaims write happened alongside this one", so there is no
      // rules-only way to require the pairing without also blocking the
      // legitimate transfer. A compromised canApproveMembers() account
      // could therefore still move a member's flat via a raw write without
      // touching flatClaims, desynchronising the two — closing that
      // residual gap needs a Cloud Function (validate + write both sides
      // server-side), not a tighter rule.
      allow update: if (
                      isAdmin() && validMemberShape() && (
                        (canApproveMembers()
                         // Closes a gap a direct API call could otherwise use:
                         // approveMember() always sets memberID in the same
                         // transaction as status:'approved', but nothing in
                         // the rule itself required that pairing — a raw
                         // write could set status:'approved' alone, landing
                         // a member with no card, no flatClaim, and no QR
                         // that the UI never produces but the rule allowed.
                         && (request.resource.data.status != 'approved' || isNonEmptyString(request.resource.data.memberID, 40))
                         // memberID/publicToken are assigned exactly once —
                         // at the moment status first becomes 'approved' —
                         // and locked after that. Without this, a
                         // canApproveMembers() admin's raw write could
                         // reassign either on an already-approved member
                         // outside approveMember()'s controlled transaction,
                         // desynchronising members from membersPublic (a
                         // QR/card that resolves to the wrong resident).
                         && (unchanged('memberID') || (resource.data.status != 'approved' && request.resource.data.status == 'approved'))
                         && (unchanged('publicToken') || (resource.data.status != 'approved' && request.resource.data.status == 'approved'))
                         && unchanged('uid'))
                        || (unchanged('status') && unchanged('memberID') && unchanged('role') && unchanged('publicToken') && unchanged('uid') && unchanged('residentType') && unchanged('maintenanceResponsible') && unchanged('tower') && unchanged('flatNumber'))
                      )
                    ) || (
                      isOwner(uid)
                      && validMemberShape()
                      && unchanged('status')
                      && unchanged('memberID')
                      && unchanged('publicToken')
                      && unchanged('role')
                      && unchanged('uid')
                      && unchanged('tower')
                      && unchanged('flatNumber')
                      // Both of these directly control maintenance billing —
                      // residentType drives which of the two flatClaims slots
                      // (owner/tenant) a member occupies, and
                      // maintenanceResponsible is literally the flag that
                      // decides whether they're billed at all. Neither is
                      // something a resident should be able to set for
                      // themselves; changing either is an admin action
                      // (transfer/edit-member), never a self-edit.
                      && unchanged('residentType')
                      && unchanged('maintenanceResponsible')
                    );

      allow delete: if false; // soft-delete only (status: 'inactive')
    }

    // ---- One flat, one member -------------------------------------------
    // Firestore cannot express "unique across a collection" in a rule, so
    // uniqueness is bought with a document ID: flatClaims/A_101 either exists
    // or it does not. approveMember() creates it inside the same transaction
    // that approves the resident, so two people claiming the same flat cannot
    // both win — the loser's transaction fails.
    match /flatClaims/{claimId} {
      // Public so the registration form can tell a visitor "this flat is
      // already registered" before they fill out the whole form and create
      // an account, not just after. The document itself carries no name,
      // phone, or email — only tower/flatNumber/an opaque member uid/a
      // timestamp — so this reveals "is flat X occupied", not who lives
      // there or how to reach them.
      allow read: if true;
      allow create: if canApproveMembers()
                    && isNonEmptyString(request.resource.data.memberDocId, 200)
                    && isNonEmptyString(request.resource.data.tower, 50)
                    && isNonEmptyString(request.resource.data.flatNumber, 30);
      // No update: every legitimate reassignment in the app is a delete of
      // the old claim followed by a create of a new one inside a checked
      // transaction, never an in-place edit of who holds an existing claim.
      // Allowing update here would let a client bypass that transaction's
      // "is this flat actually vacant" check and directly overwrite one
      // member's claim to point at another.
      allow update: if false;
      // Released when a member is rejected or deactivated, so the flat can be
      // claimed by whoever moves in next.
      allow delete: if canApproveMembers();
    }

    // ---- Admin directory (Super Admin manages roles) --------------------
    match /admins/{uid} {
      allow read: if isAdmin();
      // Role must be one of the recognised committee posts — this is what
      // stops anyone from inventing a role string to widen their own access.
      allow create, update: if isSuperAdmin()
                            && request.resource.data.role in
                               ['superadmin','president','secretary','jointsecretary','treasurer'];
      allow delete: if isSuperAdmin();
    }

    // ---- Payments -------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);

      // A resident submitting a payment cannot pre-assign themselves a receipt
      // number, cannot mark it verified, and cannot post an invalid amount.
      // isApprovedMember() (not just isSignedIn()) — a pending or rejected
      // account authenticating successfully is not the same as being an
      // actual resident of the society, and payments/dues logic throughout
      // the app assumes every payment belongs to someone who's cleared
      // approval.
      allow create: if (isApprovedMember()
                    && request.resource.data.memberUid == request.auth.uid
                    && isValidAmount(request.resource.data.amount)
                    && isValidPaymentMode(request.resource.data.mode)
                    && isValidFY(request.resource.data.financialYear)
                    && request.resource.data.status in ['pending_approval', 'pending_verification']
                    && (absentOrNull(request.resource.data, 'type') || request.resource.data.type in ['membership', 'maintenance', 'event'])
                    // An event payment with no eventId can never be matched
                    // to the event it's supposedly for — eventDue() and the
                    // treasurer's per-event collected-total both key off
                    // p.eventId === eventId, so a missing one means the
                    // ₹ silently never counts anywhere.
                    && (request.resource.data.type != 'event' || isNonEmptyString(request.resource.data.eventId, 200))
                    && absentOrNull(request.resource.data, 'receiptNumber')
                    && absentOrNull(request.resource.data, 'publicToken')
                    // Name and flat must match the caller's OWN member record —
                    // not just be non-empty. Without this a modified client
                    // could submit a payment under their own memberUid but
                    // carrying another resident's name/flat, and verifyPayment()
                    // copies these straight onto the issued receipt, so the
                    // wrong details would propagate into the financial record.
                    && request.resource.data.residentName
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name
                    && request.resource.data.flatNumber
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.flatNumber
                    && isOptionalString(request.resource.data, 'utrOrChequeNo', 40))
                    // Treasurer / Super Admin recording a payment handed in or
                    // confirmed at the office — cash, cheque, or a UPI/bank
                    // transfer the treasurer has independently verified — on
                    // the member's behalf. The money is already received, so
                    // it is created verified with a receipt in one step.
                    // memberUid is someone else's here, so this path is gated
                    // strictly on canVerifyPayments().
                    || (canVerifyPayments()
                    && isValidAmount(request.resource.data.amount)
                    && request.resource.data.mode in ['cash', 'cheque', 'upi', 'netbanking']
                    && isValidFY(request.resource.data.financialYear)
                    && request.resource.data.status == 'verified'
                    && request.resource.data.type in ['membership', 'maintenance', 'event']
                    && (request.resource.data.type != 'event' || isNonEmptyString(request.resource.data.eventId, 200))
                    && request.resource.data.recordedByAdmin == true
                    && request.resource.data.verifiedBy == request.auth.token.email
                    && isNonEmptyString(request.resource.data.receiptNumber, 60)
                    && isPublicToken(request.resource.data.publicToken)
                    // memberUid must be a REAL member, and the name/flat the
                    // treasurer is recording against must match that
                    // member's actual record — a typo'd or wrong UID
                    // (fat-fingered, copy-pasted from the wrong row) used to
                    // be able to create a financial record for a
                    // non-existent resident, or silently attribute payment
                    // to the wrong flat, with nothing catching it server-side.
                    && exists(/databases/$(database)/documents/members/$(request.resource.data.memberUid))
                    && request.resource.data.residentName
                       == get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.name
                    && request.resource.data.flatNumber
                       == get(/databases/$(database)/documents/members/$(request.resource.data.memberUid)).data.flatNumber
                    && isOptionalString(request.resource.data, 'utrOrChequeNo', 40));

      // Verifying a payment issues a receipt number and moves money in the
      // books, so changing anything about a payment is restricted to the
      // Treasurer / Super Admin.
      //
      // Three update shapes are allowed:
      //  (a) the normal verify/reject flow — status is the only thing this
      //      path is meant to change, plus issuing a receipt when approving.
      //  (b) a correction edit — the Treasurer fixing a genuine data-entry
      //      mistake (wrong amount, wrong FY, wrong mode). This is allowed
      //      even on an already-verified payment, because "verified
      //      payments never change" turned out to make ordinary typos
      //      uncorrectable, which is worse for the books than an accountable,
      //      logged correction. The app writes an audit-log entry for every
      //      correction; that log — not a frozen document — is what makes the
      //      change traceable.
      //  (c) voiding — see the note on `delete` below for why this exists
      //      instead of deletion for anything that was ever verified.
      //
      // memberUid and recordedByAdmin are locked no matter which shape this
      // is: correcting a typo in the amount is one thing, but silently
      // reassigning WHOSE payment this is would corrupt two members' dues
      // at once with no trace of it happening. If a payment was genuinely
      // recorded against the wrong resident, the correct fix is to void it
      // and create a fresh one for the right person — not repoint this one.
      allow update: if canVerifyPayments()
                    && unchanged('memberUid')
                    && unchanged('recordedByAdmin')
                    && isValidPaymentStatus(request.resource.data.status)
                    && isValidAmount(request.resource.data.amount)
                    && isValidPaymentMode(request.resource.data.mode)
                    && isValidFY(request.resource.data.financialYear)
                    // Name/flat must still match the (locked) memberUid's real
                    // record — not merely be non-empty. Otherwise a correction
                    // edit could keep memberUid but swap in another resident's
                    // name/flat, which then prints on the receipt and shows in
                    // ledger/history. exists() guards a member deleted after
                    // the payment was recorded.
                    && exists(/databases/$(database)/documents/members/$(resource.data.memberUid))
                    && request.resource.data.residentName
                       == get(/databases/$(database)/documents/members/$(resource.data.memberUid)).data.name
                    && request.resource.data.flatNumber
                       == get(/databases/$(database)/documents/members/$(resource.data.memberUid)).data.flatNumber
                    && isOptionalString(request.resource.data, 'utrOrChequeNo', 40)
                    && isOptionalString(request.resource.data, 'remarks', 500)
                    // A receipt number, once issued, is never rewritten or removed —
                    // correcting the amount on a receipted payment does not reissue
                    // a new receipt number, it keeps the one already handed out.
                    && (absentOrNull(resource.data, 'receiptNumber') || unchanged('receiptNumber'))
                    && (absentOrNull(resource.data, 'publicToken') || unchanged('publicToken'))
                    // Marking something verified must actually produce a receipt
                    // AND record who verified it and when — an audit-complete
                    // financial record, not just a receipt number floating free.
                    && (request.resource.data.status != 'verified' || (
                          isNonEmptyString(request.resource.data.receiptNumber, 40)
                          && isPublicToken(request.resource.data.publicToken)
                          && isNonEmptyString(request.resource.data.verifiedBy, 150)
                          && request.resource.data.verifiedAt is timestamp
                       ))
                    // Voiding must say who and why — this is the one status
                    // change that permanently reduces someone's recorded
                    // payments, so it does not get to be silent the way a
                    // routine correction can be.
                    && (request.resource.data.status != 'voided' || (
                          resource.data.status == 'verified'
                          && isNonEmptyString(request.resource.data.voidReason, 500)
                          && request.resource.data.voidedBy == request.auth.token.email
                          // A locked FY's books are closed — voiding a
                          // verified payment from that year would change a
                          // reviewed year's numbers after the fact.
                          && !exists(/databases/$(database)/documents/financialYearLocks/$(resource.data.financialYear))
                       ))
                    // Once a payment is verified, the only way out is voiding
                    // it — never a silent slide back to rejected or pending.
                    // Without this, a verified payment could be reverted to
                    // pending/rejected with no reason recorded and no receipt
                    // invalidated, leaving dues understated and a receipt
                    // someone may be holding pointing at a payment the books
                    // no longer count.
                    && (resource.data.status != 'verified' || request.resource.data.status in ['verified', 'voided'])
                    // Once voided, always voided — a void is itself a
                    // permanent record, not an editable draft.
                    && resource.data.status != 'voided';

      // A never-verified entry (duplicate, bad data-entry, abandoned
      // pending row) can be removed outright — it never affected anyone's
      // dues or the books, so there is nothing a deletion would erase from
      // the financial history. A VERIFIED payment is different: it already
      // moved money in the books and has a receipt someone may be holding,
      // so it can only be voided (see `update` above), never hard-deleted —
      // "payments never truly disappear" is the actual guarantee here, not
      // a comment that the rule then contradicts.
      allow delete: if canVerifyPayments()
                    && resource.data.status != 'verified'
                    && resource.data.status != 'voided';
    }

    // ---- Sequence counters (Member ID / Receipt No.) ---------------------
    // Admin-only, and STRICTLY INCREASING. The previous version allowed any
    // admin to write any positive integer, which meant the receipt sequence
    // could be wound backwards — accidentally or otherwise — and reissue a
    // number that is already printed on somebody's receipt. Duplicate receipt
    // numbers in a financial record are exactly what an auditor picks up on.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.value is int
                    && request.resource.data.value > 0;
      allow update: if isAdmin()
                    && request.resource.data.value is int
                    && request.resource.data.value > resource.data.value;
      allow delete: if false;
    }

    // ---- Notice board — public read, office-bearer write ------------------
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.titleEn, 200)
                            && isNonEmptyString(request.resource.data.bodyEn, 5000);
      allow delete: if canApproveMembers();

      // One read-receipt document per resident (doc ID = their own uid),
      // so "did resident X read this" is a single doc-existence check, and
      // a resident can never write anyone else's receipt. Never updated —
      // once read, the timestamp of first-read is what matters.
      match /reads/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid) && isApprovedMember();
        allow update, delete: if false;
      }
    }

    // ---- Society calendar (festivals, meetings, maintenance work,
    // shutdowns) — informational, not financial, so it uses the same
    // office-bearer permission as notices/committee rather than the
    // treasurer-focused canVerifyPayments() the fee-collection /events/
    // collection below uses. Public read so residents see it without login.
    // ---- Pet Registration ---------------------------------------------------
    // A resident's own pets — read/write scoped to the owner, plus the
    // committee (who need this for the vaccination-due reminder and for
    // handling any community complaint about a specific animal). ownerUid is
    // locked on update for the same reason memberUid is locked on a payment:
    // editing a pet's name or vaccination date is a normal correction,
    // silently reassigning WHOSE pet this is should never be possible via an
    // ordinary edit.
    // ---- Facility staff: Managing Staff / Supervisor -----------------------
    // An office-bearer creates one of these per staff member from the admin
    // panel; the staff member then logs into their own minimal app
    // (staff.html) with their real email + a password they set themselves
    // via a reset-password email — unlike guards, staff use their real
    // inbox, so this doesn't need the guard flow's fake-email trick.
    match /staff/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.name, 100)
                            && request.resource.data.role in ['manager', 'supervisor']
                            && (absentOrNull(request.resource.data, 'trade') || request.resource.data.trade in
                               ['plumber', 'electrician', 'stp', 'carpenter', 'cleaning', 'civil', 'guard', 'gardener', 'general'])
                            && request.resource.data.active is bool;
      allow delete: if canApproveMembers();
    }

    // ---- Facility inspections -----------------------------------------------
    // A staff member (Manager or Supervisor) files a checklist-based
    // inspection; once submitted it's a filed report, not a draft — no
    // update path at all, only create. Any flagged item on the checklist is
    // written into /complaints by the client as a normal complaint
    // (source: 'inspection'), so it inherits the SAME SLA tracking,
    // escalation matrix and committee visibility a resident's complaint
    // already gets, rather than this app growing a second, parallel
    // issue-tracking system next to the one that already works.
    match /inspections/{inspectionId} {
      // Approved residents CAN read inspections — this is a deliberate,
      // explicitly-requested transparency feature (residents see a
      // daily/weekly/monthly summary of facility inspections on their
      // dashboard). The tradeoff, called out honestly: a resident with
      // devtools can read the full checklist, including any staff notes on a
      // flagged item, not just the summary the UI shows. That's acceptable
      // for routine facility checks (lift, housekeeping, MEP), but staff
      // should NOT put anything sensitive/personal in an inspection note.
      // If inspections ever need to carry confidential observations, the
      // right fix is a separate admin-only summary aggregate (a Cloud
      // Function writing per-period counts residents can read) rather than
      // exposing the raw documents — not expressible in static rules alone.
      allow read: if isAdmin() || isStaff() || isApprovedMember();
      allow create: if isStaff()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.formType in ['daily-tower', 'weekly-mep', 'daily-security', 'club-house']
                    && request.resource.data.status == 'submitted'
                    && request.resource.size() < 900000;
      allow update: if false;
      allow delete: if canApproveMembers();
    }

    match /pets/{petId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      // isApprovedMember(), not just isSignedIn() — pets are a resident
      // feature, and a pending/rejected registration shouldn't be able to
      // create records via a direct API call just because the UI happens
      // not to show the button before approval.
      allow create: if isApprovedMember()
                    && request.resource.data.ownerUid == request.auth.uid
                    && isNonEmptyString(request.resource.data.name, 100)
                    && request.resource.data.species in ['dog', 'cat', 'bird', 'other'];
      allow update: if ((isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin())
                    && unchanged('ownerUid')
                    && isNonEmptyString(request.resource.data.name, 100)
                    && request.resource.data.species in ['dog', 'cat', 'bird', 'other'];
      allow delete: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
    }

    // ---- Complaints / Tickets -----------------------------------------------
    // A resident's own complaints, read/write scoped to them plus the
    // committee (office-bearers, same tier as Notices/Content — this is
    // community management, not a Treasurer-specific concern). Once a
    // complaint reaches resolved/closed, the ORIGINAL resident may add
    // exactly one thing back — a 1–5 satisfaction rating — and nothing
    // else; diff().affectedKeys().hasOnly([...]) is what makes "only the
    // rating" an enforced fact rather than a UI convention a modified
    // client could ignore.
    match /complaints/{complaintId} {
      allow read: if isAdmin()
                  || isManagerStaff()
                  || (isStaff() && resource.data.assignedToUid == request.auth.uid)
                  || (isSignedIn() && resource.data.raisedByUid == request.auth.uid);
      allow create: if (
                      isSignedIn()
                      && request.resource.data.raisedByUid == request.auth.uid
                      && isApprovedMember()
                      && isNonEmptyString(request.resource.data.title, 200)
                      && isNonEmptyString(request.resource.data.description, 2000)
                      && request.resource.data.category in
                         ['security', 'housekeeping', 'maintenance', 'electrical', 'plumbing', 'noise', 'parking', 'other']
                      && request.resource.data.status == 'open'
                    ) || (
                      isStaff()
                      && request.resource.data.raisedByUid == request.auth.uid
                      && isNonEmptyString(request.resource.data.title, 200)
                      && isNonEmptyString(request.resource.data.description, 2000)
                      && request.resource.data.category in
                         ['security', 'housekeeping', 'maintenance', 'electrical', 'plumbing', 'noise', 'parking', 'other']
                      && request.resource.data.status == 'open'
                      && request.resource.data.source == 'inspection'
                    );
      allow update: if (
                      // --- Committee: full control incl. assigning to staff
                      // and setting a target/SLA date. Still can never rewrite
                      // what the complaint was originally about.
                      canApproveMembers()
                      && unchanged('raisedByUid') && unchanged('title')
                      && unchanged('description') && unchanged('category') && unchanged('createdAt')
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'resolutionNote', 'resolvedAt', 'updatedAt', 'assignedToUid', 'assignedToName', 'targetDate', 'assignedAt'])
                      && isValidComplaintStatus(request.resource.data.status)
                      && isOptionalString(request.resource.data, 'resolutionNote', 500)
                    )
                    || (
                      // --- Staff assigning/routing work: any active staff
                      // member (a Managing Staff triaging the queue, say) can
                      // assign a complaint to a supervisor and set its target
                      // date, without needing to be committee. This branch
                      // touches ONLY the assignment fields — never status or
                      // the original complaint text — so it can't be used to
                      // silently resolve or rewrite a complaint.
                      isStaff()
                      && unchanged('raisedByUid') && unchanged('title')
                      && unchanged('description') && unchanged('category') && unchanged('createdAt')
                      && unchanged('status')
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['assignedToUid', 'assignedToName', 'targetDate', 'assignedAt', 'updatedAt'])
                    )
                    || (
                      // --- Assigned staff: may work ONLY a complaint assigned
                      // to them (resource.data.assignedToUid == their uid), and
                      // only move it forward / add a resolution note. They
                      // cannot reassign it, retarget its date, or touch a
                      // complaint that isn't theirs.
                      isStaff()
                      && resource.data.assignedToUid == request.auth.uid
                      && unchanged('raisedByUid') && unchanged('title')
                      && unchanged('description') && unchanged('category') && unchanged('createdAt')
                      && unchanged('assignedToUid') && unchanged('targetDate')
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'resolutionNote', 'resolvedAt', 'updatedAt'])
                      && request.resource.data.status in ['in_progress', 'resolved']
                      && isOptionalString(request.resource.data, 'resolutionNote', 500)
                    )
                    || (
                      // --- Resident, rating a closed/resolved complaint (unchanged from before)
                      isSignedIn() && isOwner(resource.data.raisedByUid)
                      && resource.data.status in ['resolved', 'closed']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['satisfactionRating', 'updatedAt'])
                      && request.resource.data.satisfactionRating is int
                      && request.resource.data.satisfactionRating >= 1
                      && request.resource.data.satisfactionRating <= 5
                    )
                    || (
                      // --- Resident verification of a resolved complaint:
                      // the person who raised it either ACCEPTS the fix
                      // (resolved -> closed) or REOPENS it if it isn't
                      // actually fixed (resolved -> in_progress). Only the
                      // raiser, only from 'resolved', only these two targets.
                      isSignedIn() && isOwner(resource.data.raisedByUid)
                      && resource.data.status == 'resolved'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'residentVerifiedAt', 'reopenNote'])
                      && request.resource.data.status in ['closed', 'in_progress']
                      && isOptionalString(request.resource.data, 'reopenNote', 500)
                    );
      allow delete: if isAdmin();
    }

    match /calendarEvents/{calId} {
      allow read: if true;
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.title, 200)
                            && isNonEmptyString(request.resource.data.date, 20);
      allow delete: if canApproveMembers();
    }

    // ---- Digital polls (one-member-one-vote) -------------------------------
    // A vote's DOCUMENT ID is the voter's own uid — that is what makes
    // double-voting impossible at the database level, not a client-side
    // check that a modified client could skip. Once votes/{uid} exists for a
    // poll, the only path back to that same document is an update, which is
    // denied below; a genuinely new vote can only ever be a create, and
    // create only succeeds where nothing exists yet.
    //
    // Privacy note: votes are readable by any signed-in approved member so
    // results can be tallied client-side — this project has no server
    // backend to compute an aggregate for it. The UI only ever shows totals,
    // never who voted for what, but that is a UI convention, not
    // cryptographic ballot secrecy: someone querying Firestore directly
    // could see the raw voter-uid-to-option pairing. Fine for a low-stakes
    // RWA preference poll; not a fit for anything needing a truly secret
    // ballot.
    function pollIsOpen(pollId) {
      let poll = get(/databases/$(database)/documents/polls/$(pollId)).data;
      return request.time >= poll.startTime && request.time <= poll.endTime;
    }
    // A client-side dropdown only ever offers the poll's real options, but a
    // modified client could submit any string — "option is string" alone
    // would accept a vote for something that was never on the ballot. This
    // re-fetches the same poll doc pollIsOpen() already reads and checks the
    // submitted value is actually one of its options.
    function optionIsValid(pollId, option) {
      let poll = get(/databases/$(database)/documents/polls/$(pollId)).data;
      return option in poll.options;
    }
    match /polls/{pollId} {
      allow read: if true;
      // No update — admin.html has no edit-existing-poll UI (only create and
      // delete), so this was pure unused attack surface: a modified client
      // could otherwise change a poll's question/options after votes had
      // already been cast, silently changing what people thought they were
      // voting on.
      allow create: if canApproveMembers()
                    && isNonEmptyString(request.resource.data.question, 300)
                    && request.resource.data.options is list
                    && request.resource.data.options.size() >= 2
                    && request.resource.data.options.size() <= 10
                    && request.resource.data.startTime is timestamp
                    && request.resource.data.endTime is timestamp
                    && request.resource.data.endTime > request.resource.data.startTime;
      allow delete: if canApproveMembers();

      match /votes/{voterUid} {
        // Only the voter's own read and admin tallying are allowed — any
        // signed-in resident being able to read this previously meant one
        // resident could look up exactly how another specific resident
        // voted, which defeats the point of a vote. Restricting reads this
        // way doesn't make votes anonymous FROM the admin (admin still
        // reads every vote to tally results, since there's no server-side
        // aggregation in a static-hosted app), but it closes the far more
        // exposed gap: resident-to-resident visibility.
        allow read: if isOwner(voterUid) || isAdmin();
        allow create: if isOwner(voterUid)
                      && isApprovedMember()
                      && request.resource.data.option is string
                      && optionIsValid(pollId, request.resource.data.option)
                      && pollIsOpen(pollId);
        allow update, delete: if false;   // a cast vote is final
      }
    }

    // ---- Event fees (Diwali, functions, etc.) -----------------------------
    // Public read so residents see active event demands and their fee in the
    // payment modal. Only the Treasurer/Super Admin (canVerifyPayments) can
    // create, edit, or raise the demand.
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if canVerifyPayments()
                            && isNonEmptyString(request.resource.data.name, 120)
                            && request.resource.data.feeAmount is number
                            && request.resource.data.feeAmount > 0;
      allow delete: if canVerifyPayments();
    }

    // ---- Committee directory — public read --------------------------------
    match /committee/{memberId} {
      allow read: if true;
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.name, 100)
                            && isNonEmptyString(request.resource.data.role, 60);
      allow delete: if canApproveMembers();
    }

    // ---- Society, payment and maintenance settings — public read ----------
    // Covers settings/society, settings/payment and settings/maintenance.
    // These decide what residents pay into and how much they owe, so writes
    // are limited to the Super Admin and Treasurer. Public read is required:
    // the resident portal shows bank details and each flat's dues before
    // anyone signs in.
    match /settings/{settingId} {
      // paymentPrivate carries the bank account number, IFSC and branch —
      // fine for an approved resident deciding how to pay, or an admin, but
      // not for someone who has merely created an account and is still
      // pending (or was rejected) — isSignedIn() alone let that case
      // through. Every other settings doc (society info, the public UPI ID
      // / QR / account holder name residents need to recognize before
      // paying, maintenance rates) stays genuinely public — this is
      // deliberately the one narrow exception, not a general lockdown.
      allow read: if settingId == 'paymentPrivate' ? (isApprovedMember() || isAdmin()) : true;
      allow write: if canVerifyPayments();
    }

    // ---- Public receipt verification (where the receipt QR lands) ---------
    //
    // KEYED BY RANDOM TOKEN, NOT BY RECEIPT NUMBER. This collection is
    // world-readable so a resident can check a receipt without an account —
    // but when the document ID was the sequential receipt number, anyone could
    // request MHMRWS-2026-000001, 000002, 000003 ... and walk out with every
    // payer name, flat and amount the society had ever banked, which totals to
    // the society's income. The 128-bit token in the QR code fixes that: a
    // scan still resolves instantly, a crawler gets nothing.
    //
    // Documents written before this change are still keyed by receipt number,
    // so receipts already in residents' hands keep verifying. See MIGRATION.md.
    match /receiptsPublic/{token} {
      allow read: if true;
      allow create: if canVerifyPayments()
                    && isValidAmount(request.resource.data.amount)
                    && isNonEmptyString(request.resource.data.receiptNumber, 40);
      // A verified receipt is a financial record — normally immutable — but
      // it must be kept in sync with its payments/{id} counterpart: if the
      // Treasurer corrects the amount on a receipted payment, the public
      // receipt has to show the same corrected figure, not a stale one. If
      // the underlying payment is deleted as a mistake, the receipt must stop
      // verifying as real. Both actions are logged in auditLogs.
      allow update: if canVerifyPayments()
                    && isValidAmount(request.resource.data.amount)
                    && isNonEmptyString(request.resource.data.receiptNumber, 40)
                    && unchanged('receiptNumber')
                    && unchanged('residentName') && unchanged('flatNumber')
                    && unchanged('tower') && unchanged('financialYear');
      allow delete: if canVerifyPayments();
    }

    // ---- Expenses — public read, Treasurer writes -------------------------
    // Readable by everyone on purpose: this is the society's own money and
    // the same figures go into the audited accounts. Only the Treasurer and
    // Super Admin can record or remove an entry, matching who may verify
    // payments — money in and money out are governed identically.
    // Expense Approval Workflow — deliberately additive, not a breaking
    // change: the Treasurer/Super Admin's EXISTING direct-entry workflow is
    // untouched (they can still create an expense that's immediately
    // 'approved', exactly as before). What's new: any other office-bearer
    // (canApproveMembers()) can now create an expense too, but ONLY as a
    // 'pending_approval' request — they cannot mark their own request
    // approved. Every expense written before this change has no status
    // field at all; app code treats an absent status as legacy-approved,
    // so nothing already in the database needs a migration.
    //
    // Read is admin-only by design: a raw expense record carries vendor
    // names, bill references, and payment details that go beyond what
    // "financial transparency" requires residents or the public to see
    // line-by-line. The aggregate figures residents and visitors actually
    // care about — collected, spent, balance, category breakdown — live in
    // publicFinancialSummary below instead, kept in sync by the admin app
    // whenever this collection changes.
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if (
        (canVerifyPayments() && request.resource.data.status in ['approved', 'pending_approval'])
        || (canApproveMembers() && request.resource.data.status == 'pending_approval')
      )
        && isNonEmptyString(request.resource.data.description, 200)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && isValidFY(request.resource.data.financialYear)
        && request.resource.data.mode in ['cash','cheque','bank','upi'];
      // Approving, rejecting, or editing a request all go through the same
      // Treasurer/Super Admin gate that direct-entry already used — a
      // second office-bearer approving is not required, keeping this a
      // one-approver workflow rather than a full multi-sign-off chain.
      // addedBy/addedAt are locked: they record who originally raised this
      // entry and when, which an edit — even a correction — must not be
      // able to quietly rewrite.
      //
      // Once approved, an expense is real spent money, not a draft — the
      // financial facts (amount/category/description/FY) lock the same way
      // a verified payment's do. The one thing still allowed from there is
      // marking it voided, which requires a reason, mirroring how a
      // verified payment can only be voided, never quietly edited back to
      // looking like it never happened.
      allow update: if canVerifyPayments()
                    && request.resource.data.status in ['approved', 'pending_approval', 'rejected', 'voided']
                    && (absentOrNull(resource.data, 'addedBy') || unchanged('addedBy'))
                    && (absentOrNull(resource.data, 'addedAt') || unchanged('addedAt'))
                    && (
                      !(absentOrNull(resource.data, 'status') || resource.data.status == 'approved')
                      || (unchanged('amount') && unchanged('category') && unchanged('description') && unchanged('financialYear'))
                    )
                    && (request.resource.data.status != 'voided' || (
                          isNonEmptyString(request.resource.data.voidReason, 300)
                          // A locked FY's books are closed — voiding an
                          // approved expense from that year would change a
                          // reviewed year's numbers after the fact.
                          && !exists(/databases/$(database)/documents/financialYearLocks/$(resource.data.financialYear))
                       ));
      // Hard delete only for a request that never became real money — once
      // approved (or already voided, which is itself a permanent record of
      // the reversal), it stays in the ledger forever. A missing status
      // (legacy expense, predates this workflow) counts as approved here
      // too, for the same reason the update lock above does.
      allow delete: if canVerifyPayments()
                    && !(absentOrNull(resource.data, 'status') || resource.data.status == 'approved')
                    && resource.data.status != 'voided';
    }

    // ---- Bank Reconciliation -----------------------------------------------
    // Read restricted to Treasurer/Super Admin — a bank statement line is
    // more sensitive than an expense record (it can reveal the account's
    // running behaviour), so this doesn't get the public-read treatment
    // expenses/payments get.
    // ---- Public Financial Summary -------------------------------------------
    // Aggregate-only figures for the pre-login "Accounts" transparency page:
    // collected, spent, balance, and a category breakdown — never a raw
    // transaction. Doc ID is the FY string. Written by admin-side code
    // whenever expenses/payments change, not computed live off the raw
    // collections (payments' own read rule is member-scoped, not public, so
    // an anonymous visitor's browser was never actually able to query it
    // directly — this summary is what makes the transparency page real
    // instead of silently empty for anyone who isn't an admin).
    match /publicFinancialSummary/{fy} {
      allow read: if true;
      // Type-checking alone (is number) would still accept internally
      // inconsistent figures — collected: 5, spent: 0, balance: 999 — since
      // rules can't independently re-sum the payments/expenses collections
      // the way a backend could. What rules CAN do is enforce the one
      // relationship that must always hold between these three numbers,
      // which catches an accidental miscalculation even though it can't
      // catch a wrong "collected" figure that's merely self-consistent.
      allow create, update: if canVerifyPayments()
                            && request.resource.data.collected is number
                            && request.resource.data.spent is number
                            && request.resource.data.balance is number
                            && request.resource.data.balance == request.resource.data.collected - request.resource.data.spent;
      allow delete: if false;
    }

    match /bankTransactions/{txId} {
      allow read: if canVerifyPayments();
      allow create: if canVerifyPayments()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.type in ['credit', 'debit'];
      // A matched transaction is reconciliation history — the amount/type
      // that were actually matched against a specific payment/expense must
      // stay exactly what they were when that match was made, or the match
      // itself becomes a lie. Status-transition fields (re-matching,
      // clearing a match, marking ignored) are the only things a matched
      // transaction can still change; matchTransaction()/setTxStatus() in
      // admin.html never touch amount/type, so this locks in what the code
      // already does rather than changing behavior.
      allow update: if canVerifyPayments()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.type in ['credit', 'debit']
                    && (resource.data.status != 'matched' || (
                          unchanged('amount') && unchanged('type')
                       ));
      // A matched transaction is reconciliation history — deleting it would
      // silently erase the record that a specific payment/expense was
      // confirmed against the bank statement. Unmatched or ignored entries
      // (a bad import, a duplicate paste) carry no such history and stay
      // freely deletable for cleanup.
      allow delete: if canVerifyPayments() && resource.data.status != 'matched';
    }

    // ---- Budget vs Actual ---------------------------------------------------
    // One document per financial year (doc ID is the FY string itself, e.g.
    // "2026-27"), holding every category's planned amount together — public
    // read because this app's whole "accounts" section on the resident page
    // is built around financial transparency, and a budget is exactly the
    // kind of thing an AGM would want visible.
    match /budgets/{fy} {
      allow read: if true;
      // categories is an arbitrary-keyed map, and Firestore rules can't
      // iterate it to check each value is a non-negative finite number — the
      // admin UI enforces that, and a future Cloud Function is the right
      // place for authoritative validation. What we CAN enforce here: the
      // doc id is a valid FY, categories is a map, and the doc isn't huge.
      allow create, update: if canVerifyPayments()
                            && isValidFY(fy)
                            && request.resource.data.categories is map
                            && request.resource.size() < 100000;
      // Categories can already be added, changed, or zeroed out via update —
      // there's no case where losing the whole FY's budget record is the
      // right fix for a mistake, only editing it is.
      allow delete: if false;
    }

    // ---- Monthly Financial Closing ------------------------------------------
    // Doc ID is the year-month itself (e.g. "2026-08"). A closure record is
    // never deleted, even by Super Admin — voiding a close, if it's ever
    // needed, should leave a trace rather than erase one; that's the same
    // reasoning as "void, don't delete" for individual transactions.
    match /monthClosures/{yearMonth} {
      allow read: if true;
      allow create, update: if canVerifyPayments()
                            && request.resource.data.closedAt is timestamp
                            && request.resource.data.allChecksOk is bool
                            && request.resource.size() < 5000;
      allow delete: if false;
    }

    // ---- Financial-year audit lock — the teeth monthClosures never had ----
    // monthClosures records that a month was reviewed, but nothing actually
    // stopped a verified payment or approved expense from that period being
    // voided afterward. This is the explicit, deliberate lock: once a FY is
    // locked here, voiding a verified payment or approved expense dated to
    // that FY is blocked outright — the only way to change the books for a
    // locked year is to unlock it first, which is itself a visible, logged
    // action, not a silent edit.
    match /financialYearLocks/{fy} {
      allow read: if true;
      allow create: if canVerifyPayments();
      allow delete: if canVerifyPayments(); // unlocking is deliberate and visible — the audit-log entry is what makes it accountable, not a rules-level ban
    }

    // ---- Parking slot registry — admin-managed, not resident-self-service ---
    // Doc ID is the slot number itself (e.g. "P12") — same one-doc-per-key
    // pattern as flatClaims/facilitySlots, so two admins can't simultaneously
    // assign the same physical slot to two different flats without one
    // write failing outright. Assignment fields are all-or-nothing: a slot is
    // either unassigned (fields absent/null) or fully assigned.
    match /parkingSlots/{slotId} {
      // Admin-only — vehicleNumber + assignedFlat is real PII (which flat
      // owns which registration plate), and nothing resident-facing
      // actually reads this collection, so there was no feature relying
      // on the public access this used to have.
      allow read: if isAdmin();
      allow create, update: if canApproveMembers()
                            && isOptionalString(request.resource.data, 'assignedFlat', 30)
                            && isOptionalString(request.resource.data, 'assignedMemberUid', 100)
                            && isOptionalString(request.resource.data, 'vehicleNumber', 20)
                            && isOptionalString(request.resource.data, 'notes', 300);
      allow delete: if canApproveMembers();
    }

    // ---- Ownership-change history — a permanent record, not something to
    // correct after the fact. Logged manually by admin (not auto-detected
    // from registration/deactivation, which would need to guess intent);
    // read-only once created, matching how flatClaims/monthClosures treat
    // their own "this really happened" records.
    match /ownershipHistory/{id} {
      allow read: if isAdmin();
      allow create: if canApproveMembers()
                    && isNonEmptyString(request.resource.data.tower, 50)
                    && isNonEmptyString(request.resource.data.flatNumber, 30)
                    && isNonEmptyString(request.resource.data.newOwnerName, 100)
                    && request.resource.data.changeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && isOptionalString(request.resource.data, 'previousOwnerName', 100)
                    && isOptionalString(request.resource.data, 'notes', 500);
      allow update, delete: if false;
    }

    // ---- Documents & forms — public read, office-bearer write -------------
    // Bylaws, AGM minutes, audited accounts. Deliberately world-readable:
    // these are the documents residents would otherwise have to collect from
    // the office, and several are things a prospective buyer may also ask for.
    match /documents/{docId} {
      allow read: if true;
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.title, 120)
                            && isNonEmptyString(request.resource.data.url, 2000);
      allow delete: if canApproveMembers();
    }

    // ---- Public membership verification (where the card QR lands) ---------
    //
    // Same reasoning as receiptsPublic: keyed by random token so a guard at
    // the gate can scan a card without an account, while nobody can enumerate
    // MHM-2026-000001 upwards and walk off with the society's whole resident
    // directory — every name, tower, flat and owner/tenant status.
    //
    // Holds only what the gate check needs. Never contact details, documents
    // or payment history.
    match /membersPublic/{token} {
      allow read: if true;
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.memberID, 40)
                            && request.resource.data.status in ['approved','inactive','rejected'];
      allow delete: if false;
    }

    // ---- Facility / amenity booking -----------------------------------------
    // The bookable list itself (Banquet Hall, Guest Room, etc.) — admin-
    // managed, publicly readable so the booking form can show what exists
    // without needing a signed-in read.
    match /facilities/{facilityId} {
      allow read: if true;
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.name, 100)
                            && isOptionalString(request.resource.data, 'description', 500)
                            && request.resource.data.active is bool;
      allow delete: if canApproveMembers();
    }

    // A booking REQUEST — creating one never grants the slot by itself
    // (that's what facilitySlots below is for). Multiple pending requests
    // for the same facility/date/slot can coexist; only one can ever
    // actually be approved, enforced by facilitySlots' create-uniqueness.
    match /facilityBookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      // Every claim the client makes about who/what this booking is for is
      // now checked against the actual source-of-truth documents, not just
      // shaped/typed and trusted. Previously a modified client could submit
      // a booking against a deleted/inactive facility, attach a
      // facilityName that did not match the facilityId at all, or claim
      // someone else's name/flat/tower while booking under its own uid.
      allow create: if isApprovedMember()
                    && request.resource.data.memberUid == request.auth.uid
                    && isNonEmptyString(request.resource.data.facilityId, 100)
                    && exists(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId))
                    && get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.active == true
                    && request.resource.data.facilityName
                       == get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.name
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.date >= todayISO()
                    && request.resource.data.slot in ['morning', 'evening', 'full_day']
                    && request.resource.data.residentName
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name
                    && request.resource.data.flatNumber
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.flatNumber
                    && request.resource.data.tower
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.tower
                    && isOptionalString(request.resource.data, 'purpose', 300)
                    && request.resource.data.status == 'pending';
      // Admin approves/rejects (status + decision fields only — the request
      // itself, once made, is a record of what was actually asked for and
      // should not be silently rewritten). Resident can only cancel their
      // own still-pending or already-approved booking, never flip it to
      // approved themselves.
      allow update: if (
                      canApproveMembers()
                      && unchanged('memberUid')
                      && unchanged('facilityId')
                      && unchanged('date')
                      && unchanged('slot')
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote', 'updatedAt'])
                      && request.resource.data.status in ['pending', 'approved', 'rejected', 'cancelled']
                    ) || (
                      isSignedIn() && isOwner(resource.data.memberUid)
                      && resource.data.status in ['pending', 'approved']
                      && request.resource.data.status == 'cancelled'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    );
      allow delete: if false;
    }

    // The actual conflict-lock: one document per facility+date+slot, exactly
    // the same "document either exists or it doesn't" trick flatClaims uses
    // for one-flat-one-member. Created only when a booking is approved,
    // deleted when that approval is later cancelled/rejected — so a second
    // approval attempt for an already-held slot fails outright instead of
    // racing.
    match /facilitySlots/{slotId} {
      // Signed-in only: the doc ID is a predictable "facilityId_date_slot"
      // string, so a public allow-read here would let anyone who guesses
      // one enumerate which dates/slots are taken without an account.
      allow read: if isSignedIn();
      allow create: if canApproveMembers()
                    && isNonEmptyString(request.resource.data.bookingId, 200);
      allow update: if false;
      // An office-bearer can free any slot. A resident may free ONLY the
      // slot tied to their OWN booking — this is what makes cancelling an
      // approved booking (facilityBookings.update above) actually release
      // the date/slot for someone else, instead of leaving it stuck
      // forever. Ownership is proven by reading the referenced booking,
      // never trusted from the client.
      allow delete: if canApproveMembers()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/facilityBookings/$(resource.data.bookingId)).data.memberUid == request.auth.uid);
    }

    // ---- Parking conflict-warning is a client-side scan of allMembers in
    // admin.html (same pattern as the duplicate-mobile/vehicle check at
    // approval) — no separate collection needed, and nothing here to keep
    // in sync with vehicles living inside each member document.

    // ---- Expected-guest log (NOT full visitor management) -------------------
    // Deliberately minimal: a resident telling the office "X is visiting on
    // date Y" ahead of time, for the office to relay verbally at the gate.
    // No check-in/check-out, no QR pass, no security-role UI — that's the
    // much larger Visitor Management feature this project has explicitly
    // scoped out of before. This is just a heads-up list.
    match /expectedGuests/{guestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberUid == request.auth.uid);
      // Same identity check as facilityBookings.create: residentName/tower/
      // flatNumber are cross-verified against the caller's own members/{uid}
      // record, not just type-checked — a modified client could otherwise
      // log a guest under its own uid while claiming someone else's name
      // and flat.
      allow create: if isApprovedMember()
                    && request.resource.data.memberUid == request.auth.uid
                    && isNonEmptyString(request.resource.data.guestName, 100)
                    && request.resource.data.residentName
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.name
                    && request.resource.data.tower
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.tower
                    && request.resource.data.flatNumber
                       == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.flatNumber
                    && request.resource.data.expectedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.expectedDate >= todayISO()
                    && isOptionalString(request.resource.data, 'purpose', 200);
      allow update: if isSignedIn() && isOwner(resource.data.memberUid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['expected', 'cancelled'];
      allow delete: if isAdmin() || (isSignedIn() && isOwner(resource.data.memberUid));
    }

    // ---- Suggestion box — distinct from Complaints (no specific issue to
    // fix, just an idea/feedback) ---------------------------------------------
    match /suggestions/{suggestionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.raisedByUid == request.auth.uid);
      allow create: if isApprovedMember()
                    && request.resource.data.raisedByUid == request.auth.uid
                    && isNonEmptyString(request.resource.data.text, 1000)
                    && request.resource.data.status == 'submitted';
      allow update: if canApproveMembers()
                    && unchanged('raisedByUid')
                    && unchanged('text')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt'])
                    && request.resource.data.status in ['submitted', 'under_review', 'considered', 'declined'];
      allow delete: if isAdmin();
    }

    // ---- Vendor directory — admin-only, never resident-visible --------------
    // Contact/contract info for whoever the society pays (housekeeping,
    // security agency, lift AMC, etc.) — same visibility tier as
    // paymentPrivate, not something a resident has a reason to see.
    match /vendors/{vendorId} {
      allow read: if isAdmin();
      allow create, update: if canVerifyPayments()
                            && isNonEmptyString(request.resource.data.name, 150)
                            && isOptionalString(request.resource.data, 'category', 100)
                            && isOptionalString(request.resource.data, 'contactPerson', 100)
                            && isOptionalString(request.resource.data, 'contactPhone', 20)
                            && isOptionalString(request.resource.data, 'notes', 1000);
      allow delete: if canVerifyPayments();
    }

    // ---- Assets & AMC tracking — committee-visible, not resident-facing -----
    // Lift, DG set, pumps, fire system, CCTV, etc. Whether a given asset's
    // upkeep costs money is a Treasurer question; whether the lift's AMC is
    // about to lapse is an operational one the whole committee needs to see,
    // which is why this sits at isAdmin()-read rather than vendors' narrower
    // canVerifyPayments()-only visibility.
    match /assets/{assetId} {
      allow read: if isAdmin();
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.name, 150)
                            && isOptionalString(request.resource.data, 'category', 100)
                            && isOptionalString(request.resource.data, 'amcProvider', 150)
                            && isOptionalDateString(request.resource.data, 'amcStart')
                            && isOptionalDateString(request.resource.data, 'amcEnd')
                            && isOptionalDateString(request.resource.data, 'lastServiceDate')
                            && isOptionalDateString(request.resource.data, 'nextServiceDate')
                            && isOptionalString(request.resource.data, 'notes', 1000);
      allow delete: if canApproveMembers();
    }

    // ---- Move-in / move-out tracking — admin-managed checklist, not a
    // resident self-service flow. Fixed checklist (a map of item→done),
    // not user-defined items, to keep this simple and its rules-validation
    // straightforward.
    match /moveRequests/{requestId} {
      allow read: if isAdmin();
      allow create, update: if canApproveMembers()
                            && request.resource.data.type in ['move_in', 'move_out']
                            && isNonEmptyString(request.resource.data.residentName, 100)
                            && isNonEmptyString(request.resource.data.flatNumber, 30)
                            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                            && request.resource.data.checklist is map
                            && request.resource.data.status in ['pending', 'completed'];
      allow delete: if canApproveMembers();
    }

    // ---- Activity log — append-only, never editable ------------------------
    //
    // Deliberately NOT called an audit log any more. It is written by the
    // browser, so a determined admin can simply not write an entry, and the
    // only field these rules can vouch for is userId. It is a useful record of
    // what the committee did; it is not evidence. If the society ever needs
    // something that would stand up in a dispute, the writes have to move into
    // a Cloud Function that reads context.auth and the real request IP.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Gate security: guard accounts -------------------------------------
    // An office-bearer creates one of these per guard/device from the admin
    // panel; the guard then logs in (on a separate, deliberately minimal
    // guard.html) under this account, never their own personal email. Kept
    // as its own collection rather than folded into admins/{uid} so a
    // guard account can never be mistaken for — or accidentally granted —
    // committee/financial access anywhere isAdmin() is checked.
    match /guards/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update: if canApproveMembers()
                            && isNonEmptyString(request.resource.data.name, 100)
                            && isNonEmptyString(request.resource.data.gateLabel, 100)
                            && request.resource.data.active is bool;
      allow delete: if canApproveMembers();
    }

    // ---- Gate security: visitor log ----------------------------------------
    // A guard logs who is at the gate; the resident of THAT flat decides;
    // the guard checks the visitor in, then out. "The resident of that
    // flat" is deliberately not a single memberUid — a flat can have
    // several approved members (owner, spouse, adult children, a tenant),
    // any of whom should be able to approve a guest for their own
    // household — so read/update below match on tower+flatNumber read from
    // the REQUESTER'S OWN member record via get(), the same
    // "never trust the client's claim about who they are" pattern
    // facilityBookings.create uses, never on a value the request body
    // supplies.
    //
    // Deliberately excluded: nothing here (or in guards/{uid} elsewhere) ever
    // gives a guard a resident's phone number. membersPublic already drew
    // this line for gate QR verification ("no contact details, no documents,
    // no payment history") — a guard-side "message the resident" shortcut
    // was considered and turned down for the same reason. If that's ever
    // wanted, it belongs behind a resident-controlled opt-in (e.g. a
    // settings toggle), not a default every flat is silently opted into.
    match /visitors/{visitorId} {
      allow read: if isAdmin()
                  || (isGuard() && resource.data.createdByGuardUid == request.auth.uid)
                  || (isApprovedMember()
                      && resource.data.flatKey ==
                         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.tower
                         + '_' +
                         get(/databases/$(database)/documents/members/$(request.auth.uid)).data.flatNumber);

      allow create: if isGuard()
                    && isNonEmptyString(request.resource.data.visitorName, 100)
                    && isOptionalString(request.resource.data, 'visitorPhone', 20)
                    && request.resource.data.purpose in ['guest', 'delivery', 'cab', 'service', 'other']
                    && isNonEmptyString(request.resource.data.tower, 50)
                    && isNonEmptyString(request.resource.data.flatNumber, 30)
                    && isNonEmptyString(request.resource.data.flatKey, 90)
                    && request.resource.data.createdByGuardUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Three update shapes, each a strict one-step state transition:
      //  (a) the matching resident approves or rejects a still-pending entry.
      //  (b) the guard who logged it checks an approved visitor in.
      //  (c) the guard who logged it checks a checked-in visitor out.
      // No path lets status jump straight from pending to checked_in, or
      // skip rejection back to pending — every transition is exactly the
      // one step the UI actually offers.
      allow update: if (
                      isApprovedMember()
                      && resource.data.tower == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.tower
                      && resource.data.flatNumber == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.flatNumber
                      && resource.data.status == 'pending'
                      && request.resource.data.status in ['approved', 'rejected']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedByUid', 'decidedAt', 'updatedAt'])
                    ) || (
                      isGuard() && resource.data.createdByGuardUid == request.auth.uid
                      && resource.data.status == 'approved'
                      && request.resource.data.status == 'checked_in'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkedInAt', 'updatedAt'])
                    ) || (
                      isGuard() && resource.data.createdByGuardUid == request.auth.uid
                      && resource.data.status == 'checked_in'
                      && request.resource.data.status == 'checked_out'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkedOutAt', 'updatedAt'])
                    );
      allow delete: if false;
    }

    // NOTE: no catch-all rule is needed here. Firestore denies by default —
    // any path not matched above is already inaccessible. (A trailing
    // "match /{document=**} { allow read, write: if false; }" would be a
    // no-op anyway, since rules are OR'd: it cannot revoke an allow granted
    // by a rule above it.)
  }
}
